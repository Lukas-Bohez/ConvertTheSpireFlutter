<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Flavor-specific manifest for the `full` (GitHub) distribution. -->
    <!-- Ensure broad file-access permission is declared for the GitHub build
         so the APK distributed via GitHub can request MANAGE_EXTERNAL_STORAGE
         and guide users to grant all-files access when needed. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Allow requesting legacy external storage behaviour when present.
         Note: requestLegacyExternalStorage is ignored on recent targetSdk versions,
         but some OEMs honour it; keep it for broader compatibility. -->
    <application
        tools:replace="android:requestLegacyExternalStorage"
        android:requestLegacyExternalStorage="true" />
</manifest>
